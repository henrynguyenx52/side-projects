{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "headless": true
  },
  "start_url": {
    "url": "https://tuhoc.dolenglish.vn/luyen-thi-ielts/luyen-tap-mt-reading-test-2",
    "query": []
  },
  "environment": {
    "viewport": { "width": 1440, "height": 900, "device_scale_factor": 1 },
    "locale": "vi-VN",
    "timezone": "Asia/Ho_Chi_Minh",
    "color_scheme": "light",
    "reduced_motion": "reduce",
    "service_workers": "allow"
  },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 6000
    }
  ],
  "storage": { "cookies": [], "local_storage": [], "session_storage": [] },
  "secrets": [],
  "capture": {
    "after_each_step": ["url", "accessibility", "screenshot"],
    "at_end": ["url", "accessibility", "screenshot", "dom"],
    "events": ["console", "page-errors", "network", "websockets", "frames"],
    "network": {
      "request_body": false,
      "response_body": false,
      "header_values": false
    }
  }
}
